# Copy to .env (never commit .env). Values below are placeholders.
# The setup script writes the real, locally-generated values into .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loa_vrtt
DB_USER=loa_vrtt
DB_PASSWORD=replace-with-generated-password
# Log SQL statements taking longer than this many milliseconds (50-60000).
DB_SLOW_QUERY_MS=500
TICKET_VERIFICATION_SECRET=

# Public site URL used for canonical links, Open Graph and sitemap.
SITE_URL=http://localhost:8080

# Only these email domains may self-register as requisitioners.
ALLOWED_EMAIL_DOMAINS=loa.edu.ph,lyceumalabang.edu.ph

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Goes into the page only after the visitor accepts analytics cookies.
GA_MEASUREMENT_ID=

# Google OAuth / Gmail API credentials (keep the client secret private).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail-test/callback
GOOGLE_TEST_RECIPIENT=
GOOGLE_REFRESH_TOKEN=
