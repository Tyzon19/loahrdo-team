<script>
(()=>{const root=document.currentScript&&document.currentScript.previousElementSibling&&document.currentScript.previousElementSibling.classList.contains('cmh')?document.currentScript.previousElementSibling:document.querySelector('.cmh');if(!root||root.dataset.ready)return;root.dataset.ready=1;const hw=document.querySelector('.section_header-1 .header-1-image-wrap.is-homepage');if(hw&&!hw.contains(root)){hw.querySelectorAll('.header-1-image').forEach(i=>i.remove());hw.appendChild(root);}
const cs=getComputedStyle(root),tk=n=>cs.getPropertyValue('--cmh-'+n).trim(),K={acc:tk('acc')||'#3da8ff',steel:tk('steel')||'#4e90d9',orange:tk('orange')||'#ffaf5d',card:tk('card')||'#0a1e44',pale:tk('pale')||'#b3d4f5',white:tk('white')||'#fff'};
const X=d=>56+d/91*624,Y=v=>24+(105-v)*39.43,x0=X(0),x1=X(91),xt=X(29);
const A=[[0,99.2],[7,99.6],[14,100.1],[21,100.4],[29,100.9]];
const F=[[29,100.9],[36,101.1],[43,101.3],[50,101.5],[60,101.6],[67,101.9],[74,102.1],[81,102.3],[91,102.6]];
const P=a=>a.map(([d,v])=>X(d).toFixed(1)+','+Y(v).toFixed(1)).join(' ');
const hi=F.map(([d,v])=>[d,v+1.5*(d-29)/62]),lo=F.map(([d,v])=>[d,v-1.4*(d-29)/62]).reverse();
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const PL=[[29,100.9],[36,101.1],[43,101.3],[50,101.5],[60,101.6],[60,102.42],[67,102.72],[74,102.92],[74,103.53],[81,103.73],[91,104.03]];
const PA=[[60,101.6],[60,102.42],[67,102.72],[74,102.92],[74,103.53],[81,103.73],[91,104.03],[91,102.6],[81,102.3],[74,102.1],[67,101.9]];
const lv=(c,d,a,b,m,t)=>`<g class="fd ${c}"><path d="M${X(d)+9},${Y(a)-3}V${Y(b)+3}M${X(d)+5},${Y(b)+7}L${X(d)+9},${Y(b)+3}L${X(d)+13},${Y(b)+7}" fill="none" stroke="${K.acc}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text x="${X(d)-10}" y="${Y(m)+5}" text-anchor="end" fill="${K.acc}" font-size="14" font-weight="600">${t}</text></g>`;
const UD=[114,118,116,121,119,117,122,120,118,115,119,121,117,120,118,116,113,112,105,98,92,86,80,75,70,66];
const ux0=60,ux1=780,UX=i=>ux0+i/30*(ux1-ux0),UY=v=>24+(150-v)*1.84,UB=UY(0),uxe=UX(100/7);
const uc=id=>{const UP=UD.map((v,i)=>UX(i).toFixed(1)+','+UY(v).toFixed(1)).join(' ');
let g='';for(const v of [0,50,100,150])g+=`<line x1="${ux0}" x2="${ux1}" y1="${UY(v)}" y2="${UY(v)}" stroke="rgba(255,255,255,${v===0?.18:.06})"/><text x="48" y="${UY(v)+5}" text-anchor="end">${v}</text>`;
const xl=[[0,'May','start'],[58/7,'Jul','middle'],[120/7,'Sep','middle'],[30,'Nov 30','end']].map(([i,t,a])=>`<text x="${UX(i)}" y="330" text-anchor="${a}">${t}</text>`).join('');
const ax=UX(17),ay=UY(112),bx=UX(25),by=UY(66),ox=16,oy=-16;
return `<svg class="uc" viewBox="0 0 830 340" width="100%" style="position:absolute;left:0;top:0;overflow:visible" font-size="15" fill="rgba(255,255,255,.6)">
<defs><linearGradient id="${id}ug" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${K.acc}" stop-opacity=".32"/><stop offset="1" stop-color="${K.acc}" stop-opacity="0"/></linearGradient><clipPath id="${id}ucp"><rect class="ucl" x="${ux0-4}" y="0" width="0" height="340"/></clipPath></defs>
${g}${xl}
<g class="fd ev"><line x1="${uxe}" x2="${uxe}" y1="24" y2="${UB}" stroke="${K.steel}" stroke-width="1.5" stroke-dasharray="5 5"/><text x="${uxe}" y="12" text-anchor="middle" fill="${K.pale}">Champion left &middot; Aug 12</text></g>
<g clip-path="url(#${id}ucp)"><polygon points="${UX(0)},${UB} ${UP} ${UX(25)},${UB}" fill="url(#${id}ug)"/><polyline points="${UP}" fill="none" stroke="${K.acc}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>
<g class="fd en"><circle cx="${bx}" cy="${by}" r="6" fill="${K.acc}"/><text x="${bx+12}" y="${by+26}" fill="${K.white}" font-weight="600">66 this week</text></g>
<g class="fd dc"><path d="M${ax+ox-5},${ay+oy-5}L${ax+ox},${ay+oy}L${bx+ox},${by+oy}L${bx+ox+5},${by+oy+5}" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.5" stroke-dasharray="2 4" stroke-linecap="round"/><text x="${(ax+bx)/2+ox+16}" y="${(ay+by)/2+oy-10}" fill="${K.white}" font-weight="600">&ndash;41% in 60 days</text></g>
<g class="fd rn"><line x1="${ux1}" x2="${ux1}" y1="24" y2="${UB}" stroke="${K.orange}" stroke-width="2" stroke-dasharray="6 5"/><text x="${ux1}" y="12" text-anchor="end" fill="${K.orange}" font-weight="600">Renewal &middot; Nov 30</text></g>
</svg>`;};
const wf=id=>{const B=Y(98),yT=Y(104),bx=x1+9,w=96,c=i=>56+156*(i+.5),bar=(i,a,b,fill,op)=>`<rect x="${c(i)-w/2}" y="${Y(b)}" width="${w}" height="${Y(a)-Y(b)}" rx="3" fill="${fill}" fill-opacity="${op}"/>`,cn=(i,v)=>`<line x1="${c(i)+w/2}" x2="${c(i+1)-w/2}" y1="${Y(v)}" y2="${Y(v)}" stroke="rgba(255,255,255,.35)" stroke-dasharray="2 3"/>`;
return `<svg class="wfc" viewBox="0 0 830 340" width="100%" style="overflow:visible" font-size="15" fill="rgba(255,255,255,.6)">
<line x1="${x0}" x2="${x1}" y1="${B}" y2="${B}" stroke="rgba(255,255,255,.18)"/><line x1="${x0}" x2="${x1}" y1="${Y(100)}" y2="${Y(100)}" stroke="rgba(255,255,255,.06)"/><text x="44" y="${Y(100)+5}" text-anchor="end">$100M</text><text x="44" y="${yT+5}" text-anchor="end">$104M</text>
${bar(0,98,102.6,K.steel,.4)}${bar(1,102.6,103.42,K.acc,.85)}${bar(2,103.42,104.03,K.acc,.85)}${bar(3,98,104.03,K.acc,.9)}
${cn(0,102.6)}${cn(1,103.42)}${cn(2,104.03)}
<line x1="${x0}" x2="${x1}" y1="${yT}" y2="${yT}" stroke="${K.orange}" stroke-width="1.5" stroke-dasharray="6 5"/>
<text x="${c(0)}" y="${Y(102.6)-10}" text-anchor="middle">$102.6M</text>
<text x="${c(1)}" y="${Y(102.6)+20}" text-anchor="middle" fill="${K.acc}" font-weight="600">+$820K</text>
<text x="${c(2)}" y="${Y(103.42)+20}" text-anchor="middle" fill="${K.acc}" font-weight="600">+$610K</text>
<text x="${c(3)}" y="${Y(104.03)-12}" text-anchor="middle" fill="${K.white}" font-weight="600">$104.03M</text>
${[['Current forecast',0],['Corvane Systems',1],['Wexmoor Group',2],['Plan',3]].map(([t,i])=>`<text x="${c(i)}" y="330" text-anchor="middle">${t}</text>`).join('')}
<text x="${bx+12}" y="${yT+5}" fill="${K.orange}">Target $104M</text>
<path d="M${bx+12},${yT+27} l4,4 l8,-8" fill="none" stroke="${K.acc}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><text x="${bx+30}" y="${yT+34}" fill="${K.acc}">Plan $104.03M</text>
<text x="${bx+10}" y="${yT+76}" fill="${K.acc}" class="cmh-num" font-weight="600" font-size="40" letter-spacing="-1">+$30K</text>
</svg>`;};
const mk=(d,v,lv,t)=>`<g class="fd mk"><line x1="${X(d)}" x2="${X(d)}" y1="${Y(v)+7}" y2="${Y(lv)-16}" stroke="rgba(255,255,255,.45)" stroke-dasharray="2 3"/><circle cx="${X(d)}" cy="${Y(v)}" r="5" fill="${K.card}" stroke="${K.white}" stroke-width="2"/><text x="${X(d)}" y="${Y(lv)}" text-anchor="middle" fill="rgba(255,255,255,.85)" font-size="14">${t}</text></g>`;
function chart(id){let g='';for(const v of [98,100,102])g+=`<line x1="${x0}" x2="${x1}" y1="${Y(v)}" y2="${Y(v)}" stroke="rgba(255,255,255,${v===98?.18:.06})"/>`;
let yl=[100,104].map(v=>`<text x="44" y="${Y(v)+5}" text-anchor="end">$${v}M</text>`).join('');
let xl=[[0,'Oct 1'],[31,'Nov 1'],[61,'Dec 1'],[91,'Dec 31']].map(([d,t])=>`<text x="${X(d)}" y="330" text-anchor="middle">${t}</text>`).join('');
const yT=Y(104),yF=Y(102.6),bx=x1+9;
return `<svg class="lc" viewBox="0 0 830 340" width="100%" style="display:block;overflow:visible" font-size="15" fill="rgba(255,255,255,.6)">
<defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${K.acc}" stop-opacity=".34"/><stop offset="1" stop-color="${K.acc}" stop-opacity="0"/></linearGradient><linearGradient id="${id}w" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="${K.orange}" stop-opacity="0"/><stop offset="1" stop-color="${K.orange}" stop-opacity=".28"/></linearGradient>
<clipPath id="${id}ca"><rect class="ca" x="${x0-4}" y="0" width="0" height="340"/></clipPath><clipPath id="${id}cp"><rect class="cp" x="${xt-2}" y="0" width="0" height="340"/></clipPath><clipPath id="${id}cf"><rect class="cf" x="${xt}" y="0" width="0" height="340"/></clipPath></defs>
${g}${yl}${xl}
<line x1="${xt}" x2="${xt}" y1="24" y2="300" stroke="rgba(255,255,255,.35)" stroke-dasharray="3 4"/><text x="${xt}" y="14" text-anchor="middle" font-size="14">Today</text>
<g clip-path="url(#${id}cf)"><polygon class="cone" points="${P(hi)} ${P(lo)}" fill="${K.acc}" fill-opacity=".15"/><polyline class="fcl" points="${P(F)}" fill="none" stroke="${K.acc}" stroke-width="3" stroke-dasharray="7 6" stroke-linecap="round" stroke-linejoin="round"/></g>
<g clip-path="url(#${id}ca)"><polygon points="${X(0)},300 ${P(A)} ${xt},300" fill="url(#${id}g)"/><polyline points="${P(A)}" fill="none" stroke="${K.acc}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>
<circle class="fd da" cx="${xt}" cy="${Y(100.9)}" r="6" fill="${K.acc}"/>
${mk(60,101.6,100.3,"Corvane Systems")}${mk(74,102.1,99.75,"Wexmoor Group")}<g class="fd df"><circle cx="${x1}" cy="${yF}" r="6" fill="${K.card}" stroke="${K.acc}" stroke-width="2.5"/><text x="${bx+12}" y="${yF+5}" fill="${K.acc}">Forecast $102.6M</text></g>
<g class="fd tg"><line x1="${x0}" x2="${x1}" y1="${yT}" y2="${yT}" stroke="${K.orange}" stroke-width="1.5" stroke-dasharray="6 5"/><text x="${bx+12}" y="${yT+5}" fill="${K.orange}">Target $104M</text></g>
<g class="fd gp"><g class="gpc"><rect x="${x1-1}" y="${yT}" width="${bx-x1+1}" height="${yF-yT}" fill="${K.orange}" fill-opacity=".18"/><path d="M${bx-5},${yT}H${bx}V${yF}H${bx-5}" fill="none" stroke="${K.orange}" stroke-width="2" stroke-linejoin="round"/></g><text class="gpt cmh-num" x="${bx+10}" y="${(yT+yF)/2+14}" fill="${K.orange}" font-weight="600" font-size="40" letter-spacing="-1">&ndash;$1.4M</text></g>
<polygon class="fd pa" points="${P(PA)}" fill="${K.acc}" fill-opacity=".1"/>
<g clip-path="url(#${id}cp)"><polyline points="${P(PL)}" fill="none" stroke="${K.acc}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>
${lv('lv1',60,101.6,102.42,102.01,'+$820K · save renewal')}${lv('lv2',74,102.92,103.53,103.32,'+$610K · save renewal')}
<circle class="fd pe" cx="${x1}" cy="${Y(104.03)}" r="6" fill="${K.acc}"/>
<g class="fd p30"><path d="M${bx+12},${yT-19} l4,4 l8,-8" fill="none" stroke="${K.acc}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><text x="${bx+30}" y="${yT-12}" fill="${K.acc}">Plan $104.03M</text><text x="${bx+10}" y="${(yT+yF)/2+14}" fill="${K.acc}" class="cmh-num" font-weight="600" font-size="40" letter-spacing="-1">+$30K</text></g>
<g class="fd cfl"><circle cx="${x1}" cy="${yF}" r="5" fill="${K.card}" stroke="${K.steel}" stroke-opacity=".6" stroke-width="2"/><text x="${bx+12}" y="${yF+5}" fill="rgba(255,255,255,.45)" font-size="13">Current forecast</text><text x="${bx+12}" y="${yF+21}" fill="rgba(255,255,255,.45)" font-size="13">$102.6M</text></g>
</svg>${wf(id)}${uc(id)}`;}
function mount(ab,id){
ab.appendChild(root.querySelector('template').content.cloneNode(true));
const st=ab.querySelector('.stg');st.querySelector('.chart').innerHTML=chart(id);
const vis=ab.parentElement;let NH=0,W=860;const getW=()=>parseFloat(getComputedStyle(root).getPropertyValue('--cmh-w'))||860;const lay=root.closest('.header-1_layout'),cc=lay&&lay.querySelector('.header-1-content');const size=()=>{if(!lay||!cc||innerWidth<992){root.style.width='';return}const av=lay.getBoundingClientRect().right-cc.getBoundingClientRect().right-44;root.style.width=Math.max(360,Math.min(av,880))+'px';};const fit=()=>{size();const hh=NH||st.offsetHeight;const mh=parseFloat(getComputedStyle(vis).maxHeight);const s=Math.min(vis.clientWidth/W,(mh>0?mh:1e9)/hh);st.style.transform=`scale(${s})`;ab.style.width=(W*s)+'px';ab.style.height=(hh*s)+'px';};
const qt=st.querySelector('.qt'),full=qt.textContent,dots=st.querySelector('.dots'),ca=st.querySelector('.ca'),cf=st.querySelector('.cf');
const W1=x1-x0+8,W2=x1-xt;let timers=[],raf=[];
const at=(ms,f)=>timers.push(setTimeout(f,ms));
const on=s=>st.querySelectorAll('[data-s="'+s+'"]').forEach(e=>e.classList.add('on'));
const fd=c=>st.querySelectorAll('.'+c).forEach(e=>e.classList.add('on'));
const tween=(el,w,dur)=>{const t0=performance.now();const step=t=>{const p=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-p,3);el.setAttribute('width',w*e);if(p<1)raf.push(requestAnimationFrame(step));};raf.push(requestAnimationFrame(step));};
const cp=st.querySelector('.cp'),ttl=st.querySelector('.ctl'),S=st.querySelector('[data-s="sum"]'),C=st.querySelector('[data-s="ctx"]'),H=st.querySelector('div[data-s="chip"]');
const orig={s:S.innerHTML,c:C.innerHTML,h:H.innerHTML,t:ttl.innerHTML};
const alt={s:'Save both renewals and you land at <b style="font-weight:600">$104.03M</b>, just over target. Start with <b style="font-weight:600">Corvane Systems</b> ($820K): usage is down 41% since their champion left. If Wexmoor slips, two late-stage expansion deals ($700K) would cover the difference.',c:orig.c.replace('CS churn model v3','CS churn model v3 · Live sales pipeline'),h:'<button type="button" class="chip fuc2">What&rsquo;s driving Corvane&rsquo;s drop? <span class="arr" style="color:'+K.acc+'">&rarr;</span></button>',t:'Ending ARR &middot; Q4 2026 &middot; Path to target'};
const gpt=st.querySelector('.gpt'),q2=st.querySelector('.q2');
const count=()=>{const t0=performance.now();const step=t=>{const p=Math.min(1,(t-t0)/400);gpt.textContent='–$'+Math.max(.1,1.4*(1-p)).toFixed(1)+'M';if(p<1)raf.push(requestAnimationFrame(step));};raf.push(requestAnimationFrame(step));};
const ucl=st.querySelector('.ucl'),shr=st.querySelector('.shr'),q3=st.querySelector('.q3');
const b3o={s:'Their champion left on Aug 12, and usage has fallen steadily since. <b style="font-weight:600">9 of their 14 power users</b> haven&rsquo;t logged in for 30+ days, and no one at exec level has engaged. <b style="font-weight:600">$820K ARR</b> renews Nov 30.',c:orig.c.replace(/Using[\s\S]*$/,'Using CS&rsquo;s churn model v3 &middot; Product usage events'),h:'',t:'Corvane Systems &middot; weekly active users'};
const uWe=uxe-ux0+4,uWend=UX(25)-ux0+10;
const setHTML=o=>{S.innerHTML=o.s;C.innerHTML=o.c;H.innerHTML=o.h;ttl.innerHTML=o.t;};
const WP=x1-xt+10,p1=X(60)-xt+4,p2=X(74)-xt+4;
const tw2=(el,a,b,dur)=>{const t0=performance.now();const step=t=>{const p=Math.min(1,(t-t0)/dur),e=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;el.setAttribute('width',a+(b-a)*e);if(p<1)raf.push(requestAnimationFrame(step));};raf.push(requestAnimationFrame(step));};
function reset(){timers.forEach(clearTimeout);raf.forEach(cancelAnimationFrame);timers=[];raf=[];st.classList.remove('fu','fu2','fu3','wfm','b3');shr.classList.remove('hl');ucl.setAttribute('width',0);setHTML(orig);gpt.textContent='–$1.4M';st.querySelectorAll('.st,.fd').forEach(e=>e.classList.remove('on'));ca.setAttribute('width',0);cf.setAttribute('width',0);cp.setAttribute('width',0);dots.style.display='inline-flex';qt.textContent='';}
function finalA(){reset();st.querySelectorAll('.st').forEach(e=>e.classList.add('on'));['da','df','mk','tg','gp'].forEach(fd);ca.setAttribute('width',W1);cf.setAttribute('width',W2);dots.style.display='none';qt.textContent=full;}
function finalC(){finalA();st.classList.add('fu','fu2','fu3');setHTML(alt);['pa','lv1','lv2','pe','p30','cfl'].forEach(fd);cp.setAttribute('width',WP);}
function finalB3(hl){finalC();st.classList.add('b3');setHTML(b3o);['ev','en','dc','rn','rp'].forEach(fd);ucl.setAttribute('width',uWend);if(hl)shr.classList.add('hl');}
function share(){shr.animate([{boxShadow:'0 0 0 1px rgba(61,168,255,.9),0 0 0 0 rgba(61,168,255,.45)'},{boxShadow:'0 0 0 1px rgba(61,168,255,0),0 0 0 16px rgba(61,168,255,0)'}],{duration:1200,easing:'cubic-bezier(.2,.6,.3,1)'});shr.classList.add('hl');}
function beat3(){if(st.classList.contains('b3'))return;if(reduce){finalB3(true);return}
timers.forEach(clearTimeout);timers=[];
const chip=H.querySelector('.chip'),s=chip.getBoundingClientRect(),k=parseFloat(st.style.transform.match(/[\d.]+/)[0])||1;chip.classList.add('gone');
st.classList.add('b3');[S,C,H].forEach(e=>e.classList.remove('on'));
const r=q3.getBoundingClientRect();q3.animate([{transform:`translate(${(s.left-r.left)/k}px,${(s.top-r.top)/k}px) scale(${s.height/r.height})`,opacity:.7},{transform:'none',opacity:1}],{duration:420,easing:'cubic-bezier(.3,0,.2,1)'});
at(350,()=>setHTML(b3o));
at(450,()=>tw2(ucl,0,uWe,800));at(1250,()=>fd('ev'));
at(1450,()=>tw2(ucl,uWe,uWend,700));at(2150,()=>fd('en'));at(2300,()=>fd('dc'));
at(2950,()=>{fd('rn');fd('rp')});
at(3350,()=>S.classList.add('on'));at(3550,()=>C.classList.add('on'));
at(4150,share);}
function play(){if(reduce){finalA();return}
reset();at(150,()=>on('q'));let t=300;const caret='<span class="caret"></span>';
for(let i=1;i<=full.length;i++){at(t,()=>qt.innerHTML=full.slice(0,i)+(i<full.length?caret:''));t+=32}
at(t+150,()=>on('from'));t+=750;
at(t,()=>{dots.style.display='none';on('card')});
at(t+150,()=>tween(ca,W1,750));at(t+850,()=>fd('da'));
at(t+900,()=>tween(cf,W2,850));at(t+1700,()=>fd('df'));
at(t+1750,()=>fd('mk'));at(t+2050,()=>fd('tg'));at(t+2400,()=>fd('gp'));
at(t+2800,()=>on('sum'));at(t+3050,()=>on('ctx'));at(t+3300,()=>on('chip'));}
function followUp(){if(st.classList.contains('fu'))return;if(reduce){finalC();return}
timers.forEach(clearTimeout);timers=[];
const chip=H.querySelector('.chip'),s=chip.getBoundingClientRect(),k=parseFloat(st.style.transform.match(/[\d.]+/)[0])||1;chip.classList.add('gone');
st.classList.add('fu');[S,C,H].forEach(e=>e.classList.remove('on'));
const r=q2.getBoundingClientRect();q2.animate([{transform:`translate(${(s.left-r.left)/k}px,${(s.top-r.top)/k}px) scale(${s.height/r.height})`,opacity:.7},{transform:'none',opacity:1}],{duration:420,easing:'cubic-bezier(.3,0,.2,1)'});
at(450,()=>setHTML(alt));
at(500,()=>{st.classList.add('fu2');fd('cfl')});
at(800,()=>tw2(cp,0,p1,450));at(1250,()=>fd('lv1'));
at(1500,()=>tw2(cp,p1,p2,300));at(1800,()=>fd('lv2'));
at(2000,()=>{tw2(cp,p2,WP,400);count();});
at(2400,()=>{fd('pe');st.classList.add('fu3');fd('p30');fd('pa')});
at(2850,()=>S.classList.add('on'));at(3050,()=>C.classList.add('on'));at(3250,()=>H.classList.add('on'));}
st.addEventListener('click',e=>{if(e.target.closest('.fuc'))followUp();else if(e.target.closest('.fuc2'))beat3();});
st.querySelector('.replay').onclick=play;
const measure=()=>{root.classList.add('nt');W=getW();finalA();const ha=st.offsetHeight;finalC();const hc=st.offsetHeight;finalB3();const hb=st.offsetHeight;NH=Math.max(ha,hc,hb);reset();fit();void root.offsetHeight;root.classList.remove('nt');};
measure();addEventListener('resize',()=>{if(getW()!==W){measure();if(go)play();}else fit();});
let go=0;const run=()=>{if(go)return;go=1;play();};const io='IntersectionObserver' in window?new IntersectionObserver(es=>{if(es.some(e=>e.isIntersecting)){io.disconnect();run();}},{threshold:.1}):null;
let started=0;const start=()=>{if(started)return;started=1;measure();io?io.observe(vis):run();};if(document.fonts){document.fonts.ready.then(()=>{if(!started)start();else if(!go)measure();else fit();});}setTimeout(start,500);}
const hl=()=>{document.querySelectorAll('.heading-title_title .w-richtext p').forEach(p=>{if(p.querySelector('strong'))return;const t=p.firstChild;if(t&&t.nodeType===3){const i=t.nodeValue.indexOf('24/7.');if(i>-1){const r=t.splitText(i),b=document.createElement('strong');b.textContent=r.nodeValue;p.replaceChild(b,r);}}});};hl();
mount(root.querySelector('.stage'),'cmh');
})();
</script></div><section class="section hide theme-dark"><div class="padding-global"><div class="section_padding-top padding-section-empty"><div class="section_padding-bottom padding-section-empty"><div class="section_container container-large"><div class="section_slot"><div class="marquee-university-wrap"><img src="https://cdn.prod.website-files.com/681a24354efe21a04772abd0/6846f5870f8bfcfce79aba19_Frame%201914664551.avif" loading="lazy" sizes="(max-width: 2032px) 100vw, 2032px" srcset="https://cdn.prod.website-files.com/681a24354efe21a04772abd0/6846f5870f8bfcfce79aba19_Frame%201914664551-p-500.avif 500w, https://cdn.prod.website-files.com/681a24354efe21a04772abd0/6846f5870f8bfcfce79aba19_Frame%201914664551.avif 2032w" alt="" class="line-marquee"/><div class="marquee-university-title"><h2 class="text-size-large">Trusted by</h2><div class="marquee-university-title_line"></div></div><div am-group="marquee" class="marquee-wrap"><div class="marquee-list-wrapper w-dyn-list"><div am-element="marquee" role="list" class="marquee-list w-dyn-items"><div role="listitem" class="marquee-item w-dyn-item"><div class="logo-universitie-wrap"><img src="https://cdn.prod.website-files.com/681b4afd80354b190ec3905e/6a5e61e761f011d654a6f05f_textnow.svg" loading="lazy" alt="" class="logo-university is-desktop"/><img src="https://cdn.prod.website-files.com/681b4afd80354b190ec3905e/6a5e61e761f011d654a6f05f_textnow.svg" alt="" class="logo-university is-mobile"/></div></div><div role="listitem" class="marquee-item w-dyn-item"><div class="logo-universitie-wrap"><img src="https://cdn.prod.website-files.com/681b4afd80354b190ec3905e/6a5e62b2cd21d7ccda136430_dstillery.svg" loading="lazy" alt="" class="logo-university is-desktop"/><img src="https://cdn.prod.website-files.com/681b4afd80354b190ec3905e/6a5e62b2cd21d7ccda136430_dstillery.svg" alt="" class="logo-university is-mobile"/></div></div><div role="listitem" class="marquee-item w-dyn-item"><div class="logo-universitie-wrap"><img src="https://cdn