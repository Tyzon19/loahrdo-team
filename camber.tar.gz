<!-- Box Shadows -->
<style>
    :root {
        --box-shadow: 0px 10px 20px 0px rgba(25, 25, 25, 0.08);
    }

    [box-shadow=""] {
        box-shadow: var(--box-shadow);
    }

    [box-shadow="hover"],
    [box-shadow="active"].w--current,
    [box-shadow="active"].is-active {
        transition-property: box-shadow;
        transition-duration: 200ms;
        transition-timing-function: ease;
        box-shadow: 0px 0px 0px 0px transparent;
    }

    [box-shadow="hover"]:hover,
    [box-shadow="active"].w--current,
    [box-shadow="active"].is-active {
        box-shadow: var(--box-shadow);
    }
</style>

<!-- Heading Color Effect -->
<style>
  /* Estilos apenas para cabeçalhos */
h1 strong,
h2 strong, 
h3 strong,
h4 strong,
h5 strong,
h6 strong,
h1 b,
h2 b,
h3 b,
h4 b,
h5 b,
h6 b,
[heading-color] {
    font-weight: normal;
    background: linear-gradient(100deg, #3291DF 0%, #B6DAF7 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
</style>

<!-- Heading Color Effect -->
<style>
p strong,
p b
[text-color] {
    font-weight: 500;
    color: #3793E0;
}
</style>



<style>
 [btn-hover-anim="underline"] {
        position: relative;
        text-decoration: none;
    }

    [btn-hover-anim="underline"]::after {
        content: '';
        position: absolute;
        width: 100%;
        transform: scaleX(0);
        border-radius: 5px;
        height: 0.075em;
        bottom: 0;
        left: 0;
        background: currentcolor;
        transform-origin: bottom right;
        transition: transform 0.25s ease-out;
    }

    [btn-hover-anim="underline"]:hover::after {
        transform: scaleX(1);
        transform-origin: bottom left;
    }
</style>

