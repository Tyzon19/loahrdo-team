</div></div></div><div class="w-form"><form id="wf-form-Contact-Sales-Form" name="wf-form-Contact-Sales-Form" data-name="Contact Sales Form" method="get" class="modal-form" data-wf-page-id="681a24354efe21a04772abb8" data-wf-element-id="33778bda-d620-31bf-5cb6-59631f013426"><div class="fields_container"><div class="fields_wrapper"><div class="field-container"><input class="modal-field w-input" maxlength="256" name="Name" data-name="Name" placeholder="Name" type="text" id="Name" required=""/><div class="underline"></div></div><div class="field-container"><input class="modal-field w-input" maxlength="256" name="Email" data-name="Email" placeholder="Business Email" type="email" id="Email" required=""/><div class="underline"></div></div><div class="field-container"><input class="modal-field w-input" maxlength="256" name="Job" data-name="Job" placeholder="job Title" type="text" id="Job" required=""/><div class="underline"></div></div></div><div class="fields_wrapper"><div class="field-container"><input class="modal-field w-input" maxlength="256" name="Last-Name" data-name="Last Name" placeholder="Last Name" type="text" id="Last-Name" required=""/><div class="underline"></div></div><div class="field-container"><input class="modal-field w-input" maxlength="256" name="Company" data-name="Company" placeholder="Company Name" type="text" id="Company" required=""/><div class="underline"></div></div><div class="field-container"><input class="modal-field w-input" maxlength="256" name="Data" data-name="Data" placeholder="data tech stack (optional)" type="text" id="Data"/><div class="underline"></div></div></div></div><div class="button_container"><input type="submit" data-wait="Please wait..." class="button is-secondary theme-dark w-button" value="Get in touch"/></div></form><div class="success_message w-form-done"><div class="w-richtext"><p>Thanks for getting <strong>in touch!</strong></p></div></div><div class="w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div></div></div></div></main><div class="w-embed w-script"><style>
/* Platform cards (base variant, Home size): smooth dark-to-light hover.
   Keeps the original swap (image up, text down) and animates it with a JS FLIP.
   Overrides the Webflow interaction's instant display/color swaps with CSS transitions.
   Place this component after [Section] Platform on the page. */
.flipping-cards_component .f-card_item{position:relative;isolation:isolate;overflow:hidden;transition:none}
.flipping-cards_component .f-card_item::before{content:"";position:absolute;inset:0;z-index:-1;background:var(--_colors---off-white);opacity:0;transition:opacity .6s cubic-bezier(.22,1,.36,1);pointer-events:none}
.flipping-cards_component .f-card_item:hover{background-color:var(--_colors---navy-deep);background-image:linear-gradient(90deg,rgba(31,33,43,.2),rgba(6,65,120,.5) 50%,rgba(31,33,43,.2));flex-flow:column}
.flipping-cards_component .f-card_item.is-flip,.flipping-cards_component .f-card_item.is-flip:hover{flex-flow:column-reverse}
.flipping-cards_component .f-card_item:hover::before{opacity:1}
.flipping-cards_component .f-card_top{position:relative}
.flipping-cards_component .f-card_top h3{transition:color .6s cubic-bezier(.22,1,.36,1)!important}
.flipping-cards_component .f-card_item:hover .f-card_top h3{color:#464f58!important}
.flipping-cards_component .f-card_top p{display:block!important;position:absolute;left:0;right:0;top:100%;margin-top:var(--_basic-values---size--1rem);opacity:0;pointer-events:none;transition:opacity .5s ease}
.flipping-cards_component .f-card_item.is-flip .f-card_top p{position:static}
.flipping-cards_component .f-card_item:hover .f-card_top p{opacity:1}
.flipping-cards_component .img_aspect .absolute-image{display:block!important;transition:opacity .6s cubic-bezier(.22,1,.36,1)}
.flipping-cards_component .img_aspect .absolute-image.is-light{opacity:0}
.flipping-cards_component .f-card_item:hover .absolute-image.is-light{opacity:1}
.flipping-cards_component .f-card_item:hover .absolute-image.is-dark{opacity:0}
@media (prefers-reduced-motion:reduce){.flipping-cards_component .f-card_item::before,.flipping-cards_component .f-card_top p,.flipping-cards_component .img_aspect .absolute-image{transition-duration:.01s}.flipping-cards_component .f-card_top h3{transition-duration:.01s!important}}
</style>
<script>
(function () {
  var DUR = 600, EASE = 'cubic-bezier(.22,1,.36,1)';
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.flipping-cards_component .f-card_item').forEach(function (card) {
    if (card.__flip) return;
    card.__flip = 1;
    var top = card.querySelector('.f-card_top'), bot = card.querySelector('.f-card_bottom');
    if (!top || !bot) return;
    function snap() {
      return { t: top.getBoundingClientRect(), b: bot.getBoundingClientRect() };
    }
    function set(on) {
      if (card.classList.contains('is-flip') === on) return;
      var f = snap();
      top.style.transition = bot.style.transition = 'none';
      top.style.transform = bot.style.transform = '';
      card.classList.toggle('is-flip', on);
      var l = snap();
      if (reduce) { top.style.transition = bot.style.transition = ''; return; }
      top.style.transform = 'translateY(' + (f.t.top - l.t.top) + 'px)';
      bot.style.transform = 'translateY(' + (f.b.top - l.b.top) + 'px)';
      void card.offsetHeight;
      top.style.transition = bot.style.transition = 'transform ' + DUR + 'ms ' + EASE;
      top.style.transform = bot.style.transform = '';
      clearTimeout(card.__t);
      card.__t = setTimeout(function () { top.style.transition = bot.style.transition = ''; }, DUR + 60);
    }
    card.addEventListener('mouseenter', function () { set(true); });
    card.addEventListener('mouseleave', function () { set(false); });
  });
})();
</script></div></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=681a24354efe21a04772abd0" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/681a24354efe21a04772abd0/js/webflow.178cc316.6c49e074ef351f4b.js" type="text/javascript" integrity="sha384-T7im7V8liKofMsRlUSDmPAPrMuxnGyLUKxLPToIuH0scR9SPfSRtyl1Bxvq6/TtU" crossorigin="anonymous"></script><style>
.announcement_close{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:14px;color:inherit;opacity:.7;line-height:1;width:32px;height:32px;display:flex;align-items:center;justify-content:center;padding:0;-webkit-tap-highlight-color:transparent}
.announcement_close:hover{opacity:1}
@media screen and (max-width:767px){.announcement_close{top:6px;right:6px;transform:none;width:40px;height:40px;font-size:16px}#announcement-bar{padding-left:44px;padding-right:44px}}
</style>
<script>
window.addEventListener('load', function() {
  var bar = document.getElementById('announcement-bar');
  var nav = document.querySelector('.navbar');
  if (!bar || !nav) return;

  bar.style.position = 'fixed';
  bar.style.top = '0';
  bar.style.left = '0';
  bar.style.width = '100%';
  bar.style.zIndex = '9999';

  var closeBtn = document.createElement('button');
  closeBtn.type = 'button';
  closeBtn.className = 'announcement_close';
  closeBtn.setAttribute('aria-label', 'Close announcement');
  closeBtn.innerHTML = '✕';
  bar.appendChild(closeBtn);

  var lastScroll = 0;
  var barVisible = true;

  nav.style.transition = 'top 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
  bar.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';

  closeBtn.addEventListener('click', function(e) {
    // Keep the click out of the navbar so the nav menu / scroll-disable logic does not react to it
    e.preventDefault();
    e.stopPropagation();
    barVisible = false;
    bar.style.display = 'none';
    nav.classList.remove('with-announcement');
    nav.classList.add('without-announcement');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  });

  window.addEventListener('scroll', function() {
    if (!barVisible) return;
    var currentScroll = window.scrollY;

    if (currentScroll > lastScroll && currentScroll > 50) {
      bar.style.transform = 'translateY(-100%)';
      nav.classList.remove('with-announcement');
      nav.classList.add('without-announcement');
    } else {
      bar.style.transform = 'translateY(0)';
      nav.classList.remove('without-announcement');
      nav.classList.add('with-announcement');
    }

    lastScroll = currentScroll <= 0 ? 0 : currentScroll;
  }, { passive: true });
});
</script></body></html>