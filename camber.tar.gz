ine x1="2.7" y1="9.8" x2="17.4" y2="9.8"/><line x1="0" y1="18.2" x2="20" y2="18.2"/></g><g fill="#FFAF5D"><circle cx="0" cy="0" r="1.1"/><circle cx="20" cy="0" r="1.1"/><circle cx="2.7" cy="9.8" r="1.1"/><circle cx="17.4" cy="9.8" r="1.1"/><circle cx="0" cy="18.2" r="1.1"/><circle cx="20" cy="18.2" r="1.1"/></g></svg></div></div><div class="text-style-eyebrow">HOW IT WORKS</div></div></div><div data-wf--element-section-title--main-alignment="d-left-m-left" STYLE="" class="section-title w-variant-2d93bb58-46fb-23f5-b3e7-8314f46062e8"><div class="section-title_title max-width-large"><div am-element="" class="rich-text-inherit_component"><div class="rich-text-inherit w-richtext heading-style-h5"><p>Built by your data team.</p><p>Ready for everyone.</p></div></div></div><div hide-slot-if-empty="" class="section-title_slot"></div><div data-wf--element-spacer--size="empty" class="spacer"><div class="spacer_space w-variant-7f22849e-99b9-81c9-7a80-ebc4c51cc54e"></div></div></div><div data-wf--element-spacer--size="small" class="spacer"><div class="spacer_space"></div></div><div class="hiw_root"><div data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="hiw_tabs w-tabs"><div class="hiw_menu w-tab-menu"><a data-w-tab="Tab 1" class="hiw_link w-inline-block w-tab-link w--current"><div class="text-style-eyebrow is-hiw"><div>01</div><div>BUILD</div></div><div class="text-size-large">Create agents where you work</div><div class="hiw_link-desc">Build agents in Claude Code, Cursor, Camber, or any coding agent. Give them access to the data, code, files, and analysis they need to do real work.</div></a><a data-w-tab="Tab 2" class="hiw_link w-inline-block w-tab-link"><div class="text-style-eyebrow is-hiw"><div>02</div><div>SHARE</div></div><div class="text-size-large">Deploy agents for everyone</div><div class="hiw_link-desc">Publish agents so teammates can submit data tasks in plain language, without learning SQL, digging through dashboards, or waiting on another request.</div></a><a data-w-tab="Tab 3" class="hiw_link w-inline-block w-tab-link"><div class="text-style-eyebrow is-hiw"><div>03</div><div>RUN</div></div><div class="text-size-large">Put agents to work anywhere</div><div class="hiw_link-desc">Run agents with the context they need from the AI assistants and coding tools your team already uses. They query data, write and run code, launch analyses, and scale jobs with compute on demand.</div></a></div><div class="hiw_content w-tab-content"><div data-w-tab="Tab 1" class="w-tab-pane w--tab-active"><div class="hiw_media"><div class="w-embed"><video src="https://joinamply.github.io/cambercloud/anim/Homepage Video Card 1_Build.webm" autoplay muted loop playsinline></video></div><div class="hiw_badge"><div class="hiw_dot"></div><div>01 BUILD</div></div><button aria-label="Pause video" class="hiw_play"><div class="hiw_play-bar"></div><div class="hiw_play-bar"></div></button></div></div><div data-w-tab="Tab 2" class="w-tab-pane"><div class="hiw_media"><div class="w-embed"><video src="https://joinamply.github.io/cambercloud/anim/Homepage Video Card 2_Deploy.webm" preload="none" muted loop playsinline></video></div><div class="hiw_badge"><div class="hiw_dot"></div><div>02 SHARE</div></div><button aria-label="Pause video" class="hiw_play"><div class="hiw_play-bar"></div><div class="hiw_play-bar"></div></button></div></div><div data-w-tab="Tab 3" class="w-tab-pane"><div class="hiw_media"><div class="w-embed"><video src="https://joinamply.github.io/cambercloud/anim/Homepage Video Card 3_Run.webm" preload="none" muted loop playsinline></video></div><div class="hiw_badge"><div class="hiw_dot"></div><div>03 RUN</div></div><button aria-label="Pause video" class="hiw_play"><div class="hiw_play-bar"></div><div class="hiw_play-bar"></div></button></div></div></div></div><div class="w-embed w-script"><style>
.hiw_link{cursor:pointer;transition:background-color .5s cubic-bezier(.22,1,.36,1),border-color .5s cubic-bezier(.22,1,.36,1),box-shadow .5s cubic-bezier(.22,1,.36,1)}
.hiw_link.w--current{background-color:#fff;border-color:#3291df;box-shadow:0 12px 32px rgba(10,23,56,.06)}
.hiw_link:not(.w--current):hover{background-color:rgba(255,255,255,.75)}
.hiw_link .hiw_link-desc{display:block;overflow:hidden;max-height:0;opacity:0;margin-top:-20px;transition:max-height .6s cubic-bezier(.22,1,.36,1),opacity .35s ease,margin-top .6s cubic-bezier(.22,1,.36,1)}
.hiw_link.w--current .hiw_link-desc{max-height:400px;opacity:.8;margin-top:0;transition:max-height .6s cubic-bezier(.22,1,.36,1),opacity .5s ease .15s,margin-top .6s cubic-bezier(.22,1,.36,1)}
@media (max-width:767px){.hiw_link .hiw_link-desc{margin-top:-12px}.hiw_link.w--current .hiw_link-desc{margin-top:0}}
@keyframes hiwPane{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.hiw_content .w--tab-active{animation:hiwPane .6s cubic-bezier(.22,1,.36,1)}
.hiw_media .w-embed{position:absolute;top:0;right:0;bottom:0;left:0}
.hiw_media video{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover}
.hiw_play{opacity:0;transition:opacity 200ms ease}
.hiw_media:hover .hiw_play,.hiw_play:focus-visible{opacity:1}
@media (hover:none){.hiw_play{opacity:1}}
.hiw_play.is-paused .hiw_play-bar:nth-child(1){width:0;height:0;border-style:solid;border-width:8px 0 8px 13px;border-color:transparent transparent transparent #fff;border-radius:0;background:transparent}
.hiw_play.is-paused .hiw_play-bar:nth-child(2){display:none}
@media (prefers-reduced-motion:reduce){.hiw_link,.hiw_link .hiw_link-desc{transition:none}.hiw_content .w--tab-active{animation:none}}
</style>
<script>
(function(){
  var embed=document.currentScript&&document.currentScript.closest('.w-embed');
  var root=embed&&embed.parentElement;
  if(!root)return;
  var inView=false;
  var links=[].slice.call(root.querySelectorAll('.hiw_link'));
  var panes=[].slice.call(root.querySelectorAll('.w-tab-pane'));
  function play(v){var p=v.play();if(p&&p.catch)p.catch(function(){});}
  function setBtn(pane,paused){
    var b=pane.querySelector('.hiw_play');
    if(!b)return;
    b.classList.toggle('is-paused',paused);
    b.setAttribute('aria-label',paused?'Play video':'Pause video');
  }
  function activeIndex(){
    for(var i=0;i<links.length;i++){if(links[i].classList.contains('w--current'))return i;}
    return 0;
  }
  var last=-1;
  function sync(){
    var idx=activeIndex();
    var changed=idx!==last;
    last=idx;
    panes.forEach(function(pane,i){
      var v=pane.querySelector('video');
      if(!v)return;
      if(i===idx&&inView){
        if(changed){v.currentTime=0;pane.removeAttribute('data-user-paused');setBtn(pane,false);}
        if(v.paused&&!pane.hasAttribute('data-user-paused'))play(v);
      }else{
        v.pause();
      }
    });
  }
  var mo=new MutationObserver(sync);
  links.forEach(function(l){mo.observe(l,{attributes:true,attributeFilter:['class']});});
  root.querySelectorAll('.hiw_play').forEach(function(btn){
    btn.addEventListener('click',function(){
      var pane=btn.closest('.w-tab-pane');
      var v=pane&&pane.querySelector('video');
      if(!v)return;
      if(v.paused){pane.removeAttribute('data-user-paused');play(v);setBtn(pane,false);}
      else{pane.setAttribute('data-user-paused','');v.pause();setBtn(pane,true);}
    });
  });
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){
      inView=es[es.length-1].isIntersecting;
      sync();
    },{threshold:0}).observe(root);
  }else{inView=true;sync();}
})();
</script></div></div><div class="w-embed"><style>
