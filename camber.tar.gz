<style>
    /*
     * Global scale reduction (client request, Oct 2026).
     * The client found the site more comfortable to read at 90% browser zoom.
     * These values replicate that 90% zoom view at 100% zoom on desktop:
     * the fixed rem part of each formula is scaled by 0.9 and the breakpoints
     * are shifted (1920 -> 1728, 1440 -> 1296) to match.
     * Mobile (max-width: 479px) is intentionally unchanged.
     *
     * Previous values:
     *   default:           1.125rem
     *   max-width 1920px:  calc(0.3749999999999999rem + 0.6250000000000001vw)
     *   max-width 1440px:  calc(0.6565426638917794rem + 0.3121748178980229vw)
     */
    html {
        font-size: 1.0125rem;
    }

    @media screen and (max-width:1728px) {
        html {
            font-size: calc(0.3375rem + 0.625vw);
        }
    }

    @media screen and (max-width:1296px) {
        html {
            font-size: calc(0.590888rem + 0.312175vw);
        }
    }

    /* Mobile unchanged */
    @media screen and (max-width:479px) {
        html {
            font-size: calc(0.7494769874476988rem + 0.8368200836820083vw);
        }
    }
