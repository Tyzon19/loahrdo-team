/* [Section] Benchmark — scoped styles. Colors and fonts read Camber variables (hex = fallback only). */
#benchmark .benchmark_content .section-title{margin-top:var(--_sizes---space--medium,2rem)}
.bm-card{margin:0;position:relative;overflow:hidden;height:100%;background:var(--_colors---white,#fff);border:1px solid var(--_colors---blue-light,#b6daf7);border-radius:var(--_sizes---border-radius--small,1rem);padding:24px 28px 18px;display:flex;flex-direction:column;box-shadow:0 14px 40px rgba(22,60,100,.08);color:var(--_colors---black,#010c2d)}
.bm-stage{position:relative;flex:1 1 auto;display:flex;flex-direction:column;min-height:0}
.bm-k{position:absolute;left:0;top:0;z-index:2;font-family:var(--_headings---font-family-tertiary,sans-serif);font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--_colors---slate,#6d7386)}
.bm-score{position:absolute;left:0;top:34px;z-index:2;font-family:var(--_headings---font-family-secondary,sans-serif);font-size:clamp(96px,9.5vw,150px);font-weight:400;line-height:.82;letter-spacing:-.055em;color:var(--_colors---black,#010c2d)}
.bm-score span{font-size:.42em;letter-spacing:-.02em;margin-left:.12em;color:var(--_colors---blue-bright,#3da8ff)}
.bm-chart{position:relative;flex:1 1 auto;display:flex;flex-direction:column}
.bm-logo{position:absolute;left:87.04%;top:11%;width:30px;height:auto;transform:translate(-50%,calc(-100% - 6px));z-index:2;fill:var(--_colors---blue-bright,#3da8ff)}
.bm-bars{display:block;width:100%;flex:1 1 0;min-height:200px;height:auto;overflow:visible}
.bm-ax{border-top:1px solid var(--_colors---off-white,#e8eff6)}
.bm-foot{margin-top:12px;display:flex;justify-content:space-between;gap:6px 24px;flex-wrap:wrap;font-size:13px;font-weight:300;line-height:1.45;color:var(--_colors---slate,#6d7386)}
.bm-foot a{color:var(--_colors---slate,#6d7386);text-decoration:none;white-space:nowrap}
.bm-foot a:hover{color:var(--_colors---blue-sky,#3793e0)}
@media (max-width:767px){.bm-card{padding:22px 20px 16px}.bm-score{top:30px;font-size:clamp(60px,19vw,88px)}.bm-bars{min-height:170px}.bm-logo{width:22px}}
</style>
</div><div class="benchmark_grid"><div class="benchmark_content"><div class="text-eyebrow_component"><div class="icon-xsmall"><div class="w-embed"><svg width="100%" height="100%" aria-hidden="true" viewBox="0 0 128 128" fill="none" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" style="color:var(--_colors---orange,#ffaf5d)"><g stroke="currentColor" stroke-width="4"><path d="M9 64 L119 12"/><path d="M9 64 L119 64"/><path d="M9 64 L119 116"/></g><g fill="currentColor"><circle cx="9" cy="64" r="9.5"/><circle cx="119" cy="12" r="9"/><circle cx="119" cy="64" r="9"/><circle cx="119" cy="116" r="9"/></g></svg></div></div><div class="text-style-eyebrow">BENCHMARK</div></div><div data-wf--element-section-title--main-alignment="d-left-m-left" STYLE="" class="section-title w-variant-2d93bb58-46fb-23f5-b3e7-8314f46062e8"><div class="section-title_title max-width-large"><div am-element="" class="rich-text-inherit_component"><div class="rich-text-inherit w-richtext heading-style-h5"><p>Top-tier performance.</p><p>Proven on DAB.</p></div></div></div><div class="section-title_description w-variant-2d93bb58-46fb-23f5-b3e7-8314f46062e8 max-width-large"><div am-element="" class="rich-text-inherit_component"><div class="rich-text-inherit w-richtext text-size-medium text-weight-light"><p>Camber’s multi-agent framework enables data agents to learn and improve against expert-defined outcomes, delivering near-perfect accuracy on<br/>UC Berkeley’s Data Agent Benchmark.</p></div></div></div><div hide-slot-if-empty="" class="section-title_slot"></div><div data-wf--element-spacer--size="empty" class="spacer"><div class="spacer_space w-variant-7f22849e-99b9-81c9-7a80-ebc4c51cc54e"></div></div></div><div class="benchmark_cta"><div class="button-primary-wrap"><div><a modal="" data-wf--element-button--button-button---size="small" data-w-id="40df8398-5e5c-4d96-cf2e-dcb7dae468a6" href="https://app.cambercloud.com/login" target="_blank" class="button w-variant-9bfc922e-7694-a91c-2863-31a3cb5d6283 w-inline-block is-primary"><div aria-hidden="true">Try it free</div><div hide-slot-if-empty="" class="button_icon-slot w-variant-9bfc922e-7694-a91c-2863-31a3cb5d6283 flex-order-last"></div></a></div></div></div></div><div class="w-embed"><figure class="bm-card">
<div class="bm-stage"><div class="bm-k">DAB Leaderboard · Pass@1</div><div class="bm-score">95.4<span>%</span></div>
