/* Navbar sits below the announcement bar only while the bar exists and has not been scrolled away or closed (Home footer script toggles .without-announcement). */
/* Offset = real bar height (set by the script below); 2.75rem is the fallback. The bar wraps to 3 lines on mobile, so a fixed value hid the navbar. */
.navbar:not(.without-announcement):has(> .announcement_bar) {
  margin-top: var(--announcement-h, 2.75rem);
  min-height: var(--_basic-values---size--0rem);
}
