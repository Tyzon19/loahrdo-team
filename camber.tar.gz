.hiw_media{border-color:transparent;background:linear-gradient(#010c2d,#010c2d) padding-box,linear-gradient(125deg,#010c2d,#003576) border-box}
</style></div></div></div></div></div></div></section><section id="benchmark" class="section theme-surface"><div class="padding-global"><div class="section_padding-top padding-section-small"><div class="section_padding-bottom padding-section-large"><div class="section_container container-large"><div class="divider_component"><div class="divider_img"><div class="img_aspect is-dividedr"><div class="w-embed"><!-- Same shape as the site divider (divider.svg), recolored for light backgrounds -->
